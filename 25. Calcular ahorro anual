#25. Calcular ahorro anual
def calcular_ahorro_anual():
    print('--- Calculadora de Ahorro Anual ---')

    # --- Tipificación de Variables ---
    ahorro_total: float = 0.0
    deposito_mensual: float
    mes: int

    # 1. Bucle para 12 meses
    for mes in range(1, 13):
        while True:
            try:
                deposito_mensual = float(input(f'Ingrese el depósito para el mes {mes}: S/ '))
                if deposito_mensual >= 0:
                    break
                else:
                    print('Error: El depósito no puede ser negativo.')
            except ValueError:
                print('Error: Entrada no válida. Por favor, ingrese un número.')

        # 2. Acumular el depósito
        ahorro_total += deposito_mensual

        # 3. Mostrar el ahorro acumulado al final del mes
        print(f'Ahorro acumulado al final del mes {mes}: S/ {ahorro_total:.2f}')

    # 4. Mostrar el ahorro final de 12 meses
    print('\n--- Resumen Anual ---')
    print(f'El ahorro total después de 12 meses es: S/ {ahorro_total:.2f}')

# Ejecutar la función
calcular_ahorro_anual()
